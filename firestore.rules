rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() &&
        request.auth.token.email == 'uthzaaawim@gmail.com' &&
        (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'google.com');
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Validation for Student entity
    function isValidStudent(data) {
      return data.keys().hasAll(['indexNumber', 'studentName']) &&
        data.indexNumber is string && data.indexNumber.size() > 0 && data.indexNumber.size() <= 64 &&
        data.studentName is string && data.studentName.size() > 0 && data.studentName.size() <= 128 &&
        (!('isActive' in data) || data.isActive is bool) &&
        (!('importedAt' in data) || (data.importedAt is string && data.importedAt.size() <= 64)) &&
        (!('googleEmail' in data) || (data.googleEmail is string && data.googleEmail.size() <= 128)) &&
        (!('googleUid' in data) || (data.googleUid is string && data.googleUid.size() <= 128)) &&
        (!('linkedAt' in data) || (data.linkedAt is string && data.linkedAt.size() <= 64));
    }

    // Validation for TransactionRecord entity
    function isValidTransaction(data) {
      return data.keys().hasAll(['id', 'studentIndexNumber', 'studentName', 'venue', 'type', 'date', 'timestamp', 'formattedTime', 'statusAfter']) &&
        data.id is string && data.id.size() <= 64 &&
        data.studentIndexNumber is string && data.studentIndexNumber.size() <= 64 &&
        data.studentName is string && data.studentName.size() <= 128 &&
        data.venue is string && data.venue.size() <= 64 &&
        (data.type == 'ENTRY' || data.type == 'EXIT') &&
        data.date is string && data.date.size() <= 32 &&
        data.timestamp is string && data.timestamp.size() <= 64 &&
        data.formattedTime is string && data.formattedTime.size() <= 32 &&
        (data.statusAfter == 'INSIDE' || data.statusAfter == 'OUTSIDE') &&
        (!('googleEmail' in data) || (data.googleEmail is string && data.googleEmail.size() <= 128)) &&
        (!('googleUid' in data) || (data.googleUid is string && data.googleUid.size() <= 128)) &&
        (!('greeting' in data) || (data.greeting is string && data.greeting.size() <= 64)) &&
        (!('isCorrected' in data) || data.isCorrected is bool) &&
        (!('correctionId' in data) || (data.correctionId is string && data.correctionId.size() <= 64)) &&
        (!('correctionReason' in data) || (data.correctionReason is string && data.correctionReason.size() <= 256)) &&
        (!('correctedBy' in data) || (data.correctedBy is string && data.correctedBy.size() <= 128)) &&
        (!('correctionTimestamp' in data) || (data.correctionTimestamp is string && data.correctionTimestamp.size() <= 64));
    }

    // Validation for Occupancy entity
    function isValidOccupancy(data) {
      return data.keys().hasAll(['indexNumber', 'status']) &&
        data.indexNumber is string && data.indexNumber.size() <= 64 &&
        (data.status == 'INSIDE' || data.status == 'OUTSIDE') &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // Students Collection: Used for roster check and entry/exit verification
    match /students/{studentId} {
      allow read: if true;
      allow create: if isValidId(studentId) && isValidStudent(incoming()) && (isAdmin() || true);
      allow update: if isValidId(studentId) && isValidStudent(incoming()) && (
        isAdmin() ||
        incoming().diff(existing()).affectedKeys().hasOnly(['isActive', 'studentName', 'googleEmail', 'googleUid', 'linkedAt'])
      );
      allow delete: if isValidId(studentId) && isAdmin();
    }

    // Transactions Collection: Real-time Entry/Exit Swipe Logs
    match /transactions/{transactionId} {
      allow read: if true;
      allow create: if isValidId(transactionId) && isValidTransaction(incoming());
      allow update: if isValidId(transactionId) && isValidTransaction(incoming()) && (
        isAdmin() ||
        incoming().diff(existing()).affectedKeys().hasOnly([
          'isCorrected', 'type', 'correctionId', 'correctionReason', 'correctedBy', 'correctionTimestamp', 'statusAfter'
        ])
      );
      allow delete: if isValidId(transactionId) && isAdmin();
    }

    // Occupancy Collection: Live Inside/Outside Classroom Occupancy
    match /occupancy/{indexNumber} {
      allow read: if true;
      allow create, update: if isValidId(indexNumber) && isValidOccupancy(incoming());
      allow delete: if isValidId(indexNumber) && isAdmin();
    }

    // Admins Collection: Access Control List
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isBootstrappedAdmin();
    }
  }
}
